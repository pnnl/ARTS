# Build and installation directories
build/
build*/
install/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
__pycache__/

# Documentation build artifacts
docs/_build/

# IDEs, editors, tool state
.cache/
.venv/
.vscode/
.claude/
.pytest_cache/
.superpowers/
.remember/
CLAUDE.md

# Vendored dist-tarball cache (downloaded or pre-staged; pinned by SHA256 in
# third_party/CMakeLists.txt — never committed)
third_party/*.tar.bz2
third_party/*.tar.gz
third_party/*.tar.xz

# SAR generated datasets (produced by sar_datagen at build time)
third_party/ocr-apps/apps/sar/datasets/
third_party/ocrPNNL/

# Internal working material — one root per kind, never committed:
#   research/    discussion docs, plans, specs, handoffs, surveys
#   logs/        every run / campaign / mission log
#   experiments/ figure-generation campaigns and their outputs
#   scratch/     app-run byproducts + staged fixtures (harness chdirs here)
#   notes/       reading material
#   datasets/    large staged runtime datasets (README stays tracked)
/research/
/logs/
# experiments/ is untracked VALUES (machine-local profiles, campaign rosters)
# — except the paper's main-experiment definition, which is part of the
# claim and therefore tracked: the Dane profile and the paper-main roster.
/experiments/*
!/experiments/profiles/
/experiments/profiles/*
!/experiments/profiles/dane.yaml
!/experiments/benchsets/
/experiments/benchsets/*
!/experiments/benchsets/paper-main.yaml
!/experiments/benchsets/attacks.yaml
/scratch/*
!/scratch/.gitkeep
/notes/
/datasets/*
!/datasets/README.md

# Editable-install metadata for tools/artsrun
*.egg-info/
.pytest_cache/
# uv's project lockfile — artsrun installs via requirements.txt / editable
# pip, so a stray `uv run` must not leave a lock behind as tracked noise
uv.lock
